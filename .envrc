if ! has nix; then
  log_error "Nix is required; install it with nix-command and flakes enabled."
  return 1
fi

# Loading the pinned shell never installs checkout dependencies. Use
# `nix run .#js-install` explicitly (docs-dev also calls it explicitly).
watch_file pnpm-lock.yaml
watch_file pnpm-workspace.yaml
# use flake tracks the main flake; also reload for imported modules and pins.
watch_file flake.nix
watch_file flake.lock
watch_file rust-toolchain.toml
watch_dir nix
use flake
